+foreach(header csr.h appleapiopts.h)
+	configure_file(${root}/duct-tape/xnu/bsd/sys/${header}
+		${gen}/system-config-include/sys/${header} COPYONLY)
+endforeach()
+target_include_directories(dserver_system_config_test PRIVATE ${gen}/system-config-include)
 
