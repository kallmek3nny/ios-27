+int dc_cs_locate_shared_cache(const uint8_t* head, size_t head_length, uint64_t image_size, struct dc_cs_image* image, char* err, size_t errlen) {
+	if (!image) {
+		return fail(err, errlen, "null shared-cache result");
+	}
+	memset(image, 0, sizeof(*image));
+	if (!head || head_length < 56 || image_size < 56) {
+		return fail(err, errlen, "truncated shared-cache header");
+	}
+
+	/* Public mach-o/dyld_cache_format.h: dyld_cache_header and
+	 * dyld_cache_mapping_info. Read bytes, never unaligned native structs. */
+	static const struct {
+		char magic[16];
+		uint32_t cputype;
+		uint32_t cpusubtype;
+	} architectures[] = {
+		{ "dyld_v1   arm64",  0x0100000cu, 0 },
+		{ "dyld_v1  arm64e",  0x0100000cu, 2 },
+		{ "dyld_v1  x86_64",  0x01000007u, 3 },
+		{ "dyld_v1 x86_64h",  0x01000007u, 8 },
+	};
+	size_t arch;
+	for (arch = 0; arch < sizeof(architectures) / sizeof(architectures[0]); ++arch) {
+		if (memcmp(head, architectures[arch].magic, 16) == 0) {
+			break;
+		}
+	}
+	if (arch == sizeof(architectures) / sizeof(architectures[0])) {
+		return fail(err, errlen, "unsupported shared-cache magic");
+	}
+
+	uint64_t mapping_offset = read_le32(head + 16);
+	uint64_t mapping_count = read_le32(head + 20);
+	uint64_t mapping_size = mapping_count * 32;
+	uint64_t signature_offset = read_le64(head + 40);
+	uint64_t signature_size = read_le64(head + 48);
+	if (mapping_offset < 56 || mapping_count == 0 || !in_range(image_size, mapping_offset, mapping_size)) {
+		return fail(err, errlen, "shared-cache mapping table lies outside the file");
+	}
+	uint64_t mapping_end = mapping_offset + mapping_size;
+	if (signature_size < 12 || signature_size > UINT32_MAX || signature_offset < mapping_end ||
+		!in_range(image_size, signature_offset, signature_size) || signature_size != image_size - signature_offset) {
+		return fail(err, errlen, "invalid shared-cache signature footer");
+	}
+
+	image->size = image_size;
+	image->is_64 = true;
+	image->cputype = architectures[arch].cputype;
+	image->cpusubtype = architectures[arch].cpusubtype;
+	/* Require the signed range to cover both header and mapping table. */
+	image->load_commands_end = mapping_end;
+	image->signature_offset = signature_offset;
+	image->signature_size = (uint32_t)signature_size;
+	return 0;
+}
