diff --git a/src/startup/mldr/boot_hash.h b/src/startup/mldr/boot_hash.h
new file mode 100644
--- /dev/null
+++ b/src/startup/mldr/boot_hash.h
@@ -0,0 +1,10 @@
+#ifndef MLDR_BOOT_HASH_H
+#define MLDR_BOOT_HASH_H
+#include <stdint.h>
+
+/* Opaque executable identity for allocator bucketing: stable for one signed
+ * image in one Linux boot and Darling prefix. Output is 40 hex digits + NUL. */
+int mldr_executable_boothash(const char* prefix, const uint8_t cdhash[20], char output[41]);
+int mldr_executable_boothash_for_boot(const char* prefix, const char* boot_uuid,
+        const uint8_t cdhash[20], char output[41]);
+#endif
diff --git a/src/startup/mldr/boot_hash.c b/src/startup/mldr/boot_hash.c
new file mode 100644
--- /dev/null
+++ b/src/startup/mldr/boot_hash.c
@@ -0,0 +1,125 @@
+/* Original Linux implementation of the opaque executable_boothash contract.
+ * See Apple's public kern_exec.c and libmalloc xzone_malloc.c. This uses
+ * HMAC-SHA256 with a random prefix-private key, the Linux boot UUID and CDHash;
+ * the first 20 digest bytes are published, never the key. */
+#define _GNU_SOURCE
+#include "boot_hash.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/random.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int prefix_key(const char* prefix, unsigned char key[32]) {
+    int directory = open(prefix, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (directory < 0) return -errno;
+    int fd = openat(directory, ".darling-boothash-key", O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    int result = fd < 0 ? -errno : 0;
+    close(directory);
+    if (fd < 0) return result;
+    struct stat info;
+    if (fstat(fd, &info) < 0) { result = -errno; goto done; }
+    if (!S_ISREG(info.st_mode) || info.st_uid != getuid() || info.st_nlink != 1 || (info.st_mode & 077)) {
+        result = -EPERM; goto done;
+    }
+    while (flock(fd, LOCK_EX) < 0) {
+        if (errno == EINTR) continue;
+        result = -errno; goto done;
+    }
+    if (fstat(fd, &info) < 0) { result = -errno; goto done; }
+    if (info.st_size == 0) {
+        size_t have = 0;
+        while (have < 32) {
+            ssize_t got = getrandom(key + have, 32 - have, 0);
+            if (got < 0 && errno == EINTR) continue;
+            if (got <= 0) { result = got < 0 ? -errno : -EIO; goto done; }
+            have += (size_t)got;
+        }
+        have = 0;
+        while (have < 32) {
+            ssize_t put = pwrite(fd, key + have, 32 - have, (off_t)have);
+            if (put < 0 && errno == EINTR) continue;
+            if (put <= 0) { result = put < 0 ? -errno : -EIO; goto done; }
+            have += (size_t)put;
+        }
+        if (fsync(fd) < 0) { result = -errno; goto done; }
+    } else if (info.st_size != 32) {
+        result = -EINVAL; goto done;
+    } else {
+        size_t have = 0;
+        while (have < 32) {
+            ssize_t got = pread(fd, key + have, 32 - have, (off_t)have);
+            if (got < 0 && errno == EINTR) continue;
+            if (got <= 0) { result = got < 0 ? -errno : -EIO; goto done; }
+            have += (size_t)got;
+        }
+    }
+done:
+    close(fd); // also drops the flock
+    return result;
+}
+
+int mldr_executable_boothash_for_boot(const char* prefix, const char* boot_uuid,
+        const uint8_t cdhash[20], char output[41]) {
+    static const char domain[] = "Darling executable_boothash v1";
+    unsigned char key[32] = {0}, digest[EVP_MAX_MD_SIZE];
+    unsigned char input[sizeof(domain) + 36 + 20];
+    if (!prefix || !boot_uuid || !cdhash || !output) return -EINVAL;
+    output[0] = 0;
+    if (strnlen(boot_uuid, 37) != 36) return -EINVAL;
+    memcpy(input, domain, sizeof(domain));
+    for (size_t i = 0; i < 36; ++i) {
+        unsigned char c = (unsigned char)boot_uuid[i];
+        if (i == 8 || i == 13 || i == 18 || i == 23) {
+            if (c != '-') return -EINVAL;
+        } else {
+            if (c >= 'A' && c <= 'F') c += 'a' - 'A';
+            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return -EINVAL;
+        }
+        input[sizeof(domain) + i] = c;
+    }
+    memcpy(input + sizeof(domain) + 36, cdhash, 20);
+    int result = prefix_key(prefix, key);
+    if (result == 0) {
+        unsigned int length = 0;
+        if (!HMAC(EVP_sha256(), key, sizeof(key), input, sizeof(input), digest, &length) || length != 32) {
+            result = -EIO;
+        } else {
+            static const char hex[] = "0123456789abcdef";
+            for (size_t i = 0; i < 20; ++i) {
+                output[2 * i] = hex[digest[i] >> 4];
+                output[2 * i + 1] = hex[digest[i] & 15];
+            }
+            output[40] = 0;
+        }
+    }
+    OPENSSL_cleanse(key, sizeof(key));
+    OPENSSL_cleanse(digest, sizeof(digest));
+    return result;
+}
+
+int mldr_executable_boothash(const char* prefix, const uint8_t cdhash[20], char output[41]) {
+    char uuid[39] = {0};
+    int fd = open("/proc/sys/kernel/random/boot_id", O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    size_t used = 0;
+    int result = 0;
+    while (used < sizeof(uuid) - 1) {
+        ssize_t got = read(fd, uuid + used, sizeof(uuid) - 1 - used);
+        if (got < 0 && errno == EINTR) continue;
+        if (got < 0) { result = -errno; break; }
+        if (got == 0) break;
+        used += (size_t)got;
+    }
+    close(fd);
+    if (result) return result;
+    if (used == 37 && uuid[36] == '\n') uuid[36] = 0;
+    else if (used != 36) return -EINVAL;
+    return mldr_executable_boothash_for_boot(prefix, uuid, cdhash, output);
+}
