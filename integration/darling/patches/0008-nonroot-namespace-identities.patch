+static void setNamespaceLink(const char* root, const char* process, const char* kind, const char* value)
+{
+	char path[512];
+	snprintf(path, sizeof(path), "%s/%s/ns/%s", root, process, kind);
+	unlink(path);
+	if (value)
+		CHECK(symlink(value, path) == 0);
+}
+
+static void test_nonroot_namespace_links(void)
+{
+	char root[] = "/tmp/darling-ns-links-XXXXXX";
+	char path[512];
+	char* made = mkdtemp(root);
+	CHECK(made != NULL);
+	if (!made)
+		return;
+	const char* directories[] = {"self", "self/ns", "server", "server/ns"};
+	for (size_t i = 0; i < sizeof(directories) / sizeof(directories[0]); i++)
+	{
+		snprintf(path, sizeof(path), "%s/%s", root, directories[i]);
+		CHECK(mkdir(path, 0700) == 0);
+	}
+	snprintf(path, sizeof(path), "%s/self", root);
+	int self = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	snprintf(path, sizeof(path), "%s/server", root);
+	int server = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	CHECK(self >= 0 && server >= 0);
+	setNamespaceLink(root, "self", "mnt", "mnt:[11]");
+	setNamespaceLink(root, "server", "mnt", "mnt:[11]");
+	setNamespaceLink(root, "self", "user", "user:[21]");
+	setNamespaceLink(root, "server", "user", "user:[21]");
+	CHECK(launcherNonRootNamespacesMatch(server, self) == 1);
+	setNamespaceLink(root, "server", "mnt", "mnt:[12]");
+	CHECK(launcherNonRootNamespacesMatch(server, self) == 0);
+	setNamespaceLink(root, "server", "mnt", "mnt:[11]");
+	setNamespaceLink(root, "server", "user", "user:[22]");
+	CHECK(launcherNonRootNamespacesMatch(server, self) == 0);
+	setNamespaceLink(root, "server", "user", NULL);
+	CHECK(launcherNonRootNamespacesMatch(server, self) == 0);
+	setNamespaceLink(root, "self", "user", NULL);
+	CHECK(launcherNonRootNamespacesMatch(server, self) == 1);
+	setNamespaceLink(root, "server", "mnt", NULL);
+	CHECK(launcherNonRootNamespacesMatch(server, self) == -1 && errno == ENOENT);
+	const char* invalid[] = {"mnt:[]", "mnt:[x]", "user:[11]", "mnt:[11]tail", "mnt:[-1]"};
+	for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++)
+	{
+		setNamespaceLink(root, "server", "mnt", invalid[i]);
+		CHECK(launcherNonRootNamespacesMatch(server, self) == -1 && errno == EINVAL);
+	}
+	char longId[100];
+	memset(longId, '1', sizeof(longId));
+	memcpy(longId, "mnt:[", 5);
+	longId[sizeof(longId) - 2] = ']';
+	longId[sizeof(longId) - 1] = '\0';
+	setNamespaceLink(root, "server", "mnt", longId);
+	CHECK(launcherNonRootNamespacesMatch(server, self) == -1 && errno == ENAMETOOLONG);
+	setNamespaceLink(root, "server", "mnt", "mnt:[11]");
+	setNamespaceLink(root, "server", "user", "not-a-namespace");
+	CHECK(launcherNonRootNamespacesMatch(server, self) == -1 && errno == EINVAL);
+	CHECK(launcherNonRootNamespacesMatch(-1, self) == -1 && errno == EBADF);
+	close(self);
+	close(server);
+	setNamespaceLink(root, "self", "mnt", NULL);
+	setNamespaceLink(root, "server", "mnt", NULL);
+	setNamespaceLink(root, "server", "user", NULL);
+	for (size_t i = sizeof(directories) / sizeof(directories[0]); i > 0; i--)
+	{
+		snprintf(path, sizeof(path), "%s/%s", root, directories[i - 1]);
+		CHECK(rmdir(path) == 0);
+	}
+	CHECK(rmdir(root) == 0);
+}
