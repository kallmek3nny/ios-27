+static int namespaceLink(int procfd, const char* path, const char* kind, char identity[64])
+{
+	ssize_t length = readlinkat(procfd, path, identity, 64);
+	if (length < 0)
+		return -1;
+	if (length >= 64)
+	{
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	size_t start = strlen(kind);
+	if ((size_t)length < start + 2 || memcmp(identity, kind, start) != 0 || identity[length - 1] != ']')
+	{
+		errno = EINVAL;
+		return -1;
+	}
+	for (size_t i = start; i + 1 < (size_t)length; i++)
+	{
+		if (identity[i] < '0' || identity[i] > '9')
+		{
+			errno = EINVAL;
+			return -1;
+		}
+	}
+	identity[length] = '\0';
+	return 0;
+}
+
+int launcherNonRootNamespacesMatch(int procfd, int selfProcfd)
+{
+	char server[64], self[64];
+	// proc_pid_ns(5): equal type/inode link identities denote the same namespace.
+	if (namespaceLink(procfd, "ns/mnt", "mnt:[", server) != 0
+		|| namespaceLink(selfProcfd, "ns/mnt", "mnt:[", self) != 0)
+		return -1;
+	if (strcmp(server, self) != 0)
+		return 0;
+	int serverResult = namespaceLink(procfd, "ns/user", "user:[", server);
+	if (serverResult < 0 && errno != ENOENT)
+		return -1;
+	int selfResult = namespaceLink(selfProcfd, "ns/user", "user:[", self);
+	if (selfResult < 0 && errno != ENOENT)
+		return -1;
+	if (serverResult < 0 || selfResult < 0)
+		return serverResult < 0 && selfResult < 0;
+	return strcmp(server, self) == 0;
+}
