--- /dev/null
+++ b/libsyscall/wrappers/darling_kernel_callbacks.h
@@ -0,0 +1,51 @@
+/* Normalize the public libkernel callback prefix before using Darling's tail.
+ * Apple version 5 places allocator callbacks where the old private tail began.
+ * The simulator host explicitly supplies its loader lookup through apple[]. */
+#ifndef DARLING_KERNEL_CALLBACKS_H
+#define DARLING_KERNEL_CALLBACKS_H
+#include <stddef.h>
+#include <stdint.h>
+
+static inline void darling_kernel_callbacks_normalize(struct _libkernel_functions* out,
+        _libkernel_functions_t in, const char* apple[]) {
+    *out = (struct _libkernel_functions){0};
+    if (!in) return;
+    if (in->version == DARLING_LIBKERNEL_FUNCTIONS_VERSION) {
+        *out = *in;
+        out->version = 4;
+        return;
+    }
+    size_t length = sizeof(in->version);
+    if (in->version >= 1) length = offsetof(struct _libkernel_functions, reserved1);
+    if (in->version >= 2) length = offsetof(struct _libkernel_functions, pthread_clear_qos_tsd);
+    if (in->version >= 3) length = offsetof(struct _libkernel_functions, pthread_current_stack_contains_np);
+    if (in->version >= 4) length = offsetof(struct _libkernel_functions, dyld_func_lookup);
+    for (size_t i = 0; i < length; ++i) ((unsigned char*)out)[i] = ((const unsigned char*)in)[i];
+    if (out->version > 4) out->version = 4;
+
+    static const char key[] = "darling_dyld_lookup=0x";
+    uintptr_t lookup = 0;
+    unsigned found = 0;
+    if (apple) for (size_t i = 0; i < 512 && apple[i]; ++i) {
+        const char* value = apple[i];
+        size_t k = 0;
+        while (k < sizeof(key) - 1 && value[k] == key[k]) ++k;
+        if (k != sizeof(key) - 1) continue;
+        if (++found > 1) { lookup = 0; break; }
+        value += k;
+        uintptr_t parsed = 0;
+        size_t digits = 0;
+        for (; *value; ++value) {
+            unsigned digit;
+            if (*value >= '0' && *value <= '9') digit = (unsigned)(*value - '0');
+            else if (*value >= 'a' && *value <= 'f') digit = (unsigned)(*value - 'a' + 10);
+            else if (*value >= 'A' && *value <= 'F') digit = (unsigned)(*value - 'A' + 10);
+            else break;
+            if (++digits > sizeof(uintptr_t) * 2) break;
+            parsed = (parsed << 4) | digit;
+        }
+        if (*value == '\0' && digits) lookup = parsed;
+    }
+    out->dyld_func_lookup = (int (*)(const char*, void**))lookup;
+}
+#endif
