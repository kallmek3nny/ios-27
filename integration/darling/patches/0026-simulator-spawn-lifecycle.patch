diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/spawn_lifecycle.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/spawn_lifecycle.c
new file mode 100644
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/spawn_lifecycle.c
@@ -0,0 +1,68 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/process/spawn_lifecycle.h>
+#include <_libkernel_init.h>
+#include <sys/errno.h>
+extern _libkernel_functions_t _libkernel_functions;
+
+#ifndef VARIANT_DYLD
+#include <libsimple/lock.h>
+#include <darling/emulation/xnu_syscall/bsd/impl/kqueue/kevent_workq.h>
+#include <darling/emulation/xnu_syscall/bsd/impl/kqueue/kevent_id.h>
+#include "spawn_hooks.h"
+
+extern int _mach_fork_parent(void);
+extern int _mach_fork_child(void);
+extern void kqueue_atfork(void);
+static struct darling_spawn_hooks external_hooks;
+static libsimple_lock_t hooks_lock = LIBSIMPLE_LOCK_INITIALIZER;
+static int hooks_ready;
+
+static void mach_parent(void) { _mach_fork_parent(); }
+static void mach_child(void) { _mach_fork_child(); }
+static void reset_async_state(void)
+{
+	darling_kevent_workq_fork_child();
+	darling_workloop_fork_child();
+}
+static void native_state_child(void)
+{
+	kqueue_atfork();
+	reset_async_state();
+}
+static void tagged_child(void)
+{
+	_libkernel_functions->posix_spawn_child();
+	reset_async_state();
+}
+static void external_prepare(void) { darling_spawn_hooks_prepare(&external_hooks); }
+static void external_parent(void) { darling_spawn_hooks_parent(&external_hooks, mach_parent); }
+static void external_child(void) { darling_spawn_hooks_child(&external_hooks, mach_child, native_state_child); }
+#endif
+
+int darling_spawn_get_handlers(struct darling_spawn_handlers* handlers)
+{
+	_libkernel_functions_t callbacks = _libkernel_functions;
+	if (!callbacks) return -ENOSYS;
+	if (callbacks->posix_spawn_prepare && callbacks->posix_spawn_parent && callbacks->posix_spawn_child) {
+		handlers->prepare = callbacks->posix_spawn_prepare;
+		handlers->parent = callbacks->posix_spawn_parent;
+#ifndef VARIANT_DYLD
+		handlers->child = tagged_child;
+#else
+		handlers->child = callbacks->posix_spawn_child;
+#endif
+		return 0;
+	}
+#ifndef VARIANT_DYLD
+	if (darling_uses_external_libsystem()) {
+		libsimple_lock_lock(&hooks_lock);
+		if (!hooks_ready) hooks_ready = darling_spawn_hooks_resolve(&external_hooks, callbacks->dlsym);
+		int ready = hooks_ready;
+		libsimple_lock_unlock(&hooks_lock);
+		if (ready) {
+			*handlers = (struct darling_spawn_handlers){external_prepare, external_parent, external_child};
+			return 0;
+		}
+	}
+#endif
+	return -ENOSYS;
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/spawn_hooks.h b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/spawn_hooks.h
