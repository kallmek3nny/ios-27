--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/spawn_hooks.h
@@ -0,0 +1,80 @@
+/* Internal-library fork ordering from Apple Libsystem-1356 (c23b5118).
+ * posix_spawn uses the library handlers without pthread_atfork callbacks.
+ * Dispatch queues are not forked into a usable child: the child execs or exits.
+ */
+#ifndef DARLING_SPAWN_HOOKS_H
+#define DARLING_SPAWN_HOOKS_H
+#include <stddef.h>
+
+enum darling_spawn_hook_id {
+	DSH_DLOPEN_PREPARE, DSH_DLOPEN_PARENT, DSH_DLOPEN_CHILD,
+	DSH_CONFIG_PREPARE, DSH_CONFIG_PARENT, DSH_CONFIG_CHILD,
+	DSH_XPC_PREPARE, DSH_XPC_PARENT, DSH_XPC_CHILD,
+	DSH_DYLD_PREPARE, DSH_DYLD_PARENT, DSH_DYLD_CHILD,
+	DSH_MALLOC_PREPARE, DSH_MALLOC_PARENT, DSH_MALLOC_CHILD,
+	DSH_CRYPTO_PREPARE, DSH_CRYPTO_PARENT, DSH_CRYPTO_CHILD,
+	DSH_LIBC_PREPARE, DSH_LIBC_PARENT, DSH_LIBC_CHILD,
+	DSH_PTHREAD_PREPARE, DSH_PTHREAD_PARENT, DSH_PTHREAD_CHILD,
+	DSH_ASL_CHILD, DSH_NOTIFY_CHILD, DSH_TRACE_CHILD, DSH_COUNT
+};
+struct darling_spawn_hooks {
+	void (*hook[DSH_COUNT])(void);
+	void (*coreservices_child)(void);
+};
+
+static inline int darling_spawn_hooks_resolve(struct darling_spawn_hooks* output,
+		void* (*lookup)(void*, const char*))
+{
+	static const char* const names[DSH_COUNT] = {
+		"_dyld_dlopen_atfork_prepare", "_dyld_dlopen_atfork_parent", "_dyld_dlopen_atfork_child",
+		"_libSC_info_fork_prepare", "_libSC_info_fork_parent", "_libSC_info_fork_child",
+		"xpc_atfork_prepare", "xpc_atfork_parent", "xpc_atfork_child",
+		"_dyld_atfork_prepare", "_dyld_atfork_parent", "_dyld_fork_child",
+		"_malloc_fork_prepare", "_malloc_fork_parent", "_malloc_fork_child",
+		"cc_atfork_prepare", "cc_atfork_parent", "cc_atfork_child",
+		"_libc_fork_prepare", "_libc_fork_parent", "_libc_fork_child",
+		"_pthread_atfork_prepare", "_pthread_atfork_parent", "_pthread_atfork_child",
+		"_asl_fork_child", "_notify_fork_child", "_libtrace_fork_child"
+	};
+	struct darling_spawn_hooks complete = {0};
+	if (!lookup) return 0;
+	for (size_t i = 0; i < DSH_COUNT; i++) {
+		complete.hook[i] = (void (*)(void))lookup((void*)-2, names[i]);
+		if (!complete.hook[i]) return 0;
+	}
+	complete.coreservices_child = (void (*)(void))lookup((void*)-2, "_libcoreservices_fork_child");
+	*output = complete;
+	return 1;
+}
+
+static inline void darling_spawn_hooks_prepare(const struct darling_spawn_hooks* table)
+{
+	const unsigned char order[] = {DSH_DLOPEN_PREPARE, DSH_CONFIG_PREPARE, DSH_XPC_PREPARE,
+		DSH_DYLD_PREPARE, DSH_MALLOC_PREPARE, DSH_CRYPTO_PREPARE, DSH_LIBC_PREPARE, DSH_PTHREAD_PREPARE};
+	for (size_t i = 0; i < sizeof(order); i++) table->hook[order[i]]();
+}
+
+static inline void darling_spawn_hooks_parent(const struct darling_spawn_hooks* table,
+		void (*mach_parent)(void))
+{
+	const unsigned char order[] = {DSH_PTHREAD_PARENT, DSH_CRYPTO_PARENT, DSH_MALLOC_PARENT,
+		DSH_LIBC_PARENT, DSH_DYLD_PARENT, DSH_XPC_PARENT, DSH_CONFIG_PARENT, DSH_DLOPEN_PARENT};
+	for (size_t i = 0; i < sizeof(order); i++) table->hook[order[i]]();
+	mach_parent();
+}
+
+static inline void darling_spawn_hooks_child(const struct darling_spawn_hooks* table,
+		void (*mach_child)(void), void (*native_state_child)(void))
+{
+	mach_child();
+	const unsigned char early[] = {DSH_PTHREAD_CHILD, DSH_CRYPTO_CHILD, DSH_MALLOC_CHILD,
+		DSH_LIBC_CHILD, DSH_DYLD_CHILD};
+	for (size_t i = 0; i < sizeof(early); i++) table->hook[early[i]]();
+	// Pthread, allocator and loader state is usable before native kqueue teardown.
+	native_state_child();
+	if (table->coreservices_child) table->coreservices_child();
+	const unsigned char late[] = {DSH_ASL_CHILD, DSH_NOTIFY_CHILD, DSH_XPC_CHILD,
+		DSH_TRACE_CHILD, DSH_CONFIG_CHILD, DSH_DLOPEN_CHILD};
+	for (size_t i = 0; i < sizeof(late); i++) table->hook[late[i]]();
+}
+#endif
