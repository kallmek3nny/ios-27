diff --git a/src/startup/mldr/elfcalls/posix_shm.c b/src/startup/mldr/elfcalls/posix_shm.c
new file mode 100644
--- /dev/null
+++ b/src/startup/mldr/elfcalls/posix_shm.c
@@ -0,0 +1,98 @@
+/* File-backed POSIX shared objects for hosts without shm_open(). The directory
+ * belongs to the runtime; object descriptors and mappings have normal kernel
+ * file lifetime, including when their name is unlinked.
+ * Contract: https://pubs.opengroup.org/onlinepubs/9799919799/functions/shm_open.html
+ */
+#define _GNU_SOURCE
+#include "posix_shm.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static const char* object_name(const char* name)
+{
+	if (!name) {
+		errno = EINVAL;
+		return NULL;
+	}
+	while (*name == '/')
+		++name;
+	size_t length = strnlen(name, NAME_MAX + 1);
+	if (length > NAME_MAX) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	if (!length || strchr(name, '/') || !strcmp(name, ".") || !strcmp(name, "..")) {
+		errno = EINVAL;
+		return NULL;
+	}
+	return name;
+}
+
+static int namespace_open(const char* directory, int create)
+{
+	if (create && mkdir(directory, 0700) < 0 && errno != EEXIST)
+		return -1;
+	return open(directory, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+}
+
+static int close_error(int fd, int error)
+{
+	close(fd);
+	errno = error;
+	return -1;
+}
+
+int mldr_shm_open(const char* directory, const char* name, int flags, unsigned short mode)
+{
+	const int allowed = O_ACCMODE | O_CREAT | O_EXCL | O_TRUNC | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK;
+	int access = flags & O_ACCMODE;
+	if ((flags & ~allowed) || (access != O_RDONLY && access != O_RDWR)) {
+		errno = EINVAL;
+		return -1;
+	}
+	name = object_name(name);
+	if (!name)
+		return -1;
+	int directory_fd = namespace_open(directory, flags & O_CREAT);
+	if (directory_fd < 0)
+		return -1;
+	/* Nonblocking open also prevents a foreign FIFO in the namespace from
+	 * hanging the caller before the regular-object check below. */
+	int fd = openat(directory_fd, name, flags | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK, mode & 0777);
+	int error = errno;
+	close(directory_fd);
+	if (fd < 0) {
+		errno = error;
+		return -1;
+	}
+	struct stat status;
+	if (fstat(fd, &status) < 0)
+		return close_error(fd, errno);
+	if (!S_ISREG(status.st_mode))
+		return close_error(fd, EINVAL);
+	if (!(flags & O_NONBLOCK)) {
+		int current = fcntl(fd, F_GETFL);
+		if (current < 0 || fcntl(fd, F_SETFL, current & ~O_NONBLOCK) < 0)
+			return close_error(fd, errno);
+	}
+	return fd;
+}
+
+int mldr_shm_unlink(const char* directory, const char* name)
+{
+	name = object_name(name);
+	if (!name)
+		return -1;
+	int directory_fd = namespace_open(directory, 0);
+	if (directory_fd < 0)
+		return -1;
+	int result = unlinkat(directory_fd, name, 0);
+	int error = errno;
+	close(directory_fd);
+	errno = error;
+	return result;
+}
