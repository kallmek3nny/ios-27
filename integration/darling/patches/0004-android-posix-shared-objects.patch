diff --git a/tests/mldr/posix_shm.c b/tests/mldr/posix_shm.c
new file mode 100644
--- /dev/null
+++ b/tests/mldr/posix_shm.c
@@ -0,0 +1,119 @@
+/* POSIX shared-object lifetime and independent-process visibility. */
+#define _GNU_SOURCE
+#include "posix_shm.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+	fprintf(stderr, "line %d: %s (errno %d)\n", __LINE__, #condition, errno); \
+	goto cleanup; \
+} } while (0)
+
+int main(void)
+{
+	const char* temporary = getenv("TMPDIR");
+	if (!temporary)
+		temporary = "/tmp";
+	char parent[PATH_MAX], directory[PATH_MAX], link[PATH_MAX];
+	if (snprintf(parent, sizeof(parent), "%s/mldr-shm-XXXXXX", temporary) >= (int)sizeof(parent)
+		|| !mkdtemp(parent))
+		return 1;
+	if (snprintf(directory, sizeof(directory), "%s/objects", parent) >= (int)sizeof(directory)
+		|| snprintf(link, sizeof(link), "%s/link", directory) >= (int)sizeof(link)) {
+		rmdir(parent);
+		return 1;
+	}
+	int result = 1, fd = -1, other = -1, truncated = -1;
+	unsigned char* mapping = MAP_FAILED;
+	mode_t old_mask = umask(0077);
+	char long_name[NAME_MAX + 2];
+	memset(long_name, 'a', sizeof(long_name) - 1);
+	long_name[sizeof(long_name) - 1] = 0;
+	const char* invalid[] = {NULL, "", "/", ".", "..", "/a/b", "/../escape"};
+	for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i) {
+		errno = 0;
+		CHECK(mldr_shm_open(directory, invalid[i], O_RDWR | O_CREAT, 0600) == -1 && errno == EINVAL);
+	}
+	CHECK(access(directory, F_OK) == -1 && errno == ENOENT);
+	CHECK(mldr_shm_open(directory, long_name, O_RDWR | O_CREAT, 0600) == -1 && errno == ENAMETOOLONG);
+	CHECK(mldr_shm_open(directory, "/object", O_WRONLY | O_CREAT, 0600) == -1 && errno == EINVAL);
+	CHECK(mldr_shm_open(directory, "/missing", O_RDWR, 0) == -1 && errno == ENOENT);
+	CHECK(mldr_shm_unlink(directory, "/missing") == -1 && errno == ENOENT);
+	fd = mldr_shm_open(directory, "/object", O_RDWR | O_CREAT | O_EXCL, 0600);
+	CHECK(fd >= 0);
+	CHECK((fcntl(fd, F_GETFD) & FD_CLOEXEC) != 0);
+	CHECK((fcntl(fd, F_GETFL) & O_NONBLOCK) == 0);
+	struct stat status;
+	CHECK(fstat(fd, &status) == 0 && status.st_size == 0 && (status.st_mode & 0777) == 0600);
+	CHECK(mldr_shm_open(directory, "/object", O_RDWR | O_CREAT | O_EXCL, 0600) == -1 && errno == EEXIST);
+	CHECK(ftruncate(fd, 4096) == 0);
+	mapping = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	CHECK(mapping != MAP_FAILED);
+	for (size_t i = 0; i < 4096; ++i)
+		CHECK(mapping[i] == 0);
+	mapping[0] = 0x39;
+	pid_t child = fork();
+	CHECK(child >= 0);
+	if (child == 0) {
+		close(fd);
+		munmap(mapping, 4096);
+		int independent = mldr_shm_open(directory, "/object", O_RDWR, 0);
+		if (independent < 0)
+			_exit(2);
+		unsigned char* view = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, independent, 0);
+		if (view == MAP_FAILED || view[0] != 0x39)
+			_exit(3);
+		view[1] = 0x82;
+		munmap(view, 4096);
+		close(independent);
+		_exit(0);
+	}
+	int child_status;
+	pid_t waited;
+	do { waited = waitpid(child, &child_status, 0); } while (waited < 0 && errno == EINTR);
+	CHECK(waited == child && WIFEXITED(child_status) && WEXITSTATUS(child_status) == 0);
+	CHECK(mapping[1] == 0x82);
+	CHECK(mldr_shm_unlink(directory, "/object") == 0);
+	CHECK(mldr_shm_open(directory, "/object", O_RDONLY, 0) == -1 && errno == ENOENT);
+	CHECK(mapping[0] == 0x39 && mapping[1] == 0x82);
+	other = mldr_shm_open(directory, "object", O_RDWR | O_CREAT | O_EXCL, 0600);
+	CHECK(other >= 0 && fstat(other, &status) == 0 && status.st_size == 0);
+	CHECK(ftruncate(other, 4096) == 0 && pwrite(other, "x", 1, 0) == 1);
+	truncated = mldr_shm_open(directory, "/object", O_RDWR | O_TRUNC, 0600);
+	CHECK(truncated >= 0 && fstat(truncated, &status) == 0 && status.st_size == 0);
+	CHECK(mapping[0] == 0x39 && mapping[1] == 0x82);
+	CHECK(symlink("../escape", link) == 0);
+	CHECK(mldr_shm_open(directory, "link", O_RDWR | O_CREAT, 0600) == -1 && errno == ELOOP);
+	CHECK(unlink(link) == 0);
+	CHECK(mkfifo(link, 0600) == 0);
+	CHECK(mldr_shm_open(directory, "link", O_RDONLY, 0) == -1 && errno == EINVAL);
+	CHECK(unlink(link) == 0);
+	result = 0;
+cleanup:
+	if (mapping != MAP_FAILED)
+		munmap(mapping, 4096);
+	if (fd >= 0)
+		close(fd);
+	if (other >= 0)
+		close(other);
+	if (truncated >= 0)
+		close(truncated);
+	unlink(link);
+	mldr_shm_unlink(directory, "/object");
+	if (rmdir(directory) < 0 && result == 0)
+		result = 1;
+	if (rmdir(parent) < 0 && result == 0)
+		result = 1;
+	umask(old_mask);
+	if (result == 0)
+		puts("POSIX shared-object contracts passed (independent process, unlink lifetime, zero fill, invalid names)");
+	return result;
+}
