--- /dev/null
+++ b/include/darlingserver/fiber-tls.hpp
@@ -0,0 +1,15 @@
+#ifndef DARLING_SERVER_FIBER_TLS_HPP
+#define DARLING_SERVER_FIBER_TLS_HPP
+#include <cstddef>
+
+namespace DarlingServer {
+// A suspended microthread may resume on another native worker. TLS addresses
+// therefore cannot remain cached across calls that switch the microthread.
+template<typename T, std::size_t Tag>
+__attribute__((noinline)) T& fiberWorkerLocal() {
+	__asm__ __volatile__("" ::: "memory");
+	static thread_local T value{};
+	return value;
+}
+}
+#endif
