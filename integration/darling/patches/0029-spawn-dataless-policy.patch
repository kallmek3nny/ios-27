new file mode 100644
--- /dev/null
+++ b/libsyscall/wrappers/darling_spawn_policy.h
@@ -0,0 +1,42 @@
+/* The native host's opaque spawn object has four padding bytes after options.
+ * Preserve every existing pointer offset while backporting dataless policy. */
+#ifndef DARLING_SPAWN_POLICY_H
+#define DARLING_SPAWN_POLICY_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <errno.h>
+#define DARLING_SPAWN_OPTIONS_OFFSET 128
+#define DARLING_SPAWN_DATALESS_OFFSET 132
+#define DARLING_SPAWN_DATALESS_OPTION 4u
+#define DARLING_DATALESS_ENV "__darling_dataless_policy"
+
+static inline int darling_spawn_read_policy(const void* attr, size_t size, int* policy)
+{
+	*policy = -1;
+	if (!attr || size < DARLING_SPAWN_OPTIONS_OFFSET + sizeof(uint32_t)) return 0;
+	uint32_t options;
+	memcpy(&options, (const char*)attr + DARLING_SPAWN_OPTIONS_OFFSET, sizeof(options));
+	if (!(options & DARLING_SPAWN_DATALESS_OPTION)) return 0;
+	if (size < DARLING_SPAWN_DATALESS_OFFSET + sizeof(int32_t)) return -EINVAL;
+	int32_t value;
+	memcpy(&value, (const char*)attr + DARLING_SPAWN_DATALESS_OFFSET, sizeof(value));
+	if (value < 0 || value > 2) return -EINVAL;
+	*policy = value;
+	return 0;
+}
+
+static inline int darling_dataless_env_policy(const char* const envp[])
+{
+	if (!envp) return -1;
+	static const char prefix[] = DARLING_DATALESS_ENV "=";
+	for (size_t i = 0; envp[i]; i++) {
+		const char* text = envp[i];
+		size_t n = 0;
+		while (n < sizeof(prefix) - 1 && text[n] && text[n] == prefix[n]) n++;
+		if (n == sizeof(prefix) - 1 && text[n] >= '0' && text[n] <= '2' && text[n + 1] == '\0')
+			return text[n] - '0';
+	}
+	return -1;
+}
+#endif
