@@ -66,6 +67,25 @@
 static volatile uint32_t process_flags;
 static volatile int process_disk = DISK_DEFAULT;
 static volatile int process_background_disk = DISK_UTILITY; // xnu: the background scope reads UTILITY unless set
+
+int darling_dataless_policy_get(void)
+{
+	return (__atomic_load_n(&process_flags, __ATOMIC_RELAXED) & PROCESS_MATERIALIZE_OFF) ? MATERIALIZE_OFF : MATERIALIZE_ON;
+}
+
+void darling_dataless_policy_set(int policy)
+{
+	if (policy == MATERIALIZE_ON)
+		__atomic_and_fetch(&process_flags, ~PROCESS_MATERIALIZE_OFF, __ATOMIC_RELAXED);
+	else
+		__atomic_or_fetch(&process_flags, PROCESS_MATERIALIZE_OFF, __ATOMIC_RELAXED);
+}
+
+void darling_dataless_policy_init(const char* const envp[])
+{
+	int policy = darling_dataless_env_policy(envp);
+	if (policy >= 0) darling_dataless_policy_set(policy);
+}
 
